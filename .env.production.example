# Production .env template.
#
# .env.example is the Laravel skeleton's local-development file — it boots the
# app on a laptop and is wrong for a live server in three ways that matter:
# APP_DEBUG=true prints the database credentials onto any error page,
# MAIL_MAILER=log means no retailer ever receives an order confirmation, and
# LOG_LEVEL=debug fills the disk. Copy this file to .env on the server instead
# and fill in the blanks. See "Deploying" in README.md for the rest.

APP_NAME="J.J. Serow Clothing Co."
APP_ENV=production
# php artisan key:generate --force  (once, on the server; never reuse the dev key)
APP_KEY=
# The single most expensive line in this file to get wrong. `true` here shows a
# stack trace — file paths, database name, credentials — to anyone who can
# trigger an error, and every API response carries it too.
APP_DEBUG=false
# Must be the real https:// origin: mailed password-reset links, the sitemap and
# the Sitemap: line in robots.txt are all built from it.
APP_URL=https://jjserow.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# The bare domain, no scheme. Leave blank if the site is on one host only.
SESSION_DOMAIN=
# Refuses to send the session cookie over plain http. Only set this once TLS is
# actually live, or nobody can sign in.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Order confirmations, status updates and password-reset links are all queued.
# Nothing is delivered until a worker is running — see README.md.
QUEUE_CONNECTION=database

CACHE_STORE=database

# Real credentials required. `log` writes mail to storage/logs and sends nothing,
# which is how a retailer ends up locked out with no reset link.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Has to be an address on a domain whose SPF/DKIM you control, or the reset mail
# lands in spam — which is the same as not sending it.
MAIL_FROM_ADDRESS="orders@jjserow.in"
MAIL_FROM_NAME="${APP_NAME}"

# Online payments. Either gateway is simply absent until its keys are here —
# nothing breaks, its button just does not appear, and retailers keep paying by
# transfer. Set the webhook secrets too: without them the webhook endpoint
# refuses every call rather than trusting an unsigned one, and a buyer whose
# browser died mid-payment will not have their order marked paid.

# Razorpay — the domestic one. UPI, netbanking, cards, in INR.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the Razorpay dashboard when you add the webhook, pointed at
# https://your-host/webhooks/razorpay for the payment.captured event.
RAZORPAY_WEBHOOK_SECRET=

# PayPal — for buyers OUTSIDE India only. PayPal stopped handling India-domestic
# payments in April 2021 and cannot settle INR cross-border, so this charges in
# USD at the rate set under admin settings. Leave blank if every buyer is Indian.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook at https://your-host/webhooks/paypal, subscribed to
# PAYMENT.CAPTURE.COMPLETED and CHECKOUT.ORDER.APPROVED.
PAYPAL_WEBHOOK_ID=
# `sandbox` until you have tested end to end with a real buyer flow.
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD

VITE_APP_NAME="${APP_NAME}"
